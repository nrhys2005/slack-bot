# 프로젝트별 설정
# name: Slack에서 입력할 프로젝트명 (키는 자유롭게 지정 가능)
# path: 프로젝트 루트 경로 (claude CLI 실행 위치)
# commands: 허용할 명령어 목록
# mcp_tools: 프로젝트가 쓸 MCP 도구 패턴(문서/향후용 메타데이터)
#   - 실제 MCP 서버 연결은 `claude mcp add -s user ...`로 등록한 ~/.claude.json에서
#     claude CLI가 해석한다. 현재 실행 코드는 이 목록을 claude 명령에 전달하지 않으며
#     (bypassPermissions로 모든 도구 허용), 어떤 도구를 의도하는지 명시하는 용도다.
# db_backend: true면 /db 커맨드에서 DB 모델·자격증명 소스로 사용 (1개만)
#   - {path}/app/.env 에서 POSTGRESQL_* 환경변수를 읽어 psql 접속에 사용
#   - DB 유저는 DB 레벨에서 read-only 권한을 가진 계정을 쓰는 것을 강력히 권장
# remote: 운영 서버가 다른 머신에 있을 때 SSH 로 관리 (선택)
#   - host: ~/.ssh/config 별칭 또는 user@host. 봇 계정에서 비밀번호 없이(키 인증) 접속돼야 한다
#   - path: 원격 서버의 프로젝트 경로. 셸 실행 시 여기로 cd 한다
#   - notes: 서비스 이름, 로그 위치 등 claude 에게 알려 줄 운영 메모
#   - 설정하면 셸 실행은 원격에서 돌고, 질문/자유 문장 프롬프트에는 ssh 접근 안내가 붙는다

projects:
  my-project:
    path: /path/to/my-project
    commands:
      - harness
      - plan
      - develop
      - review
    mcp_tools:
      - jira_*
      - linear_*
      - notion_*
      - slack_*

  # FastAPI 백엔드 — DB 모델과 .env(자격증명) 소스
  # projects.yaml 키 이름은 자유 (예: ra-backend, my_backend). 디렉토리명과 달라도 됨.
  my-backend:
    path: /path/to/my_backend
    commands: []
    db_backend: true

  # 원격 서버에서 도는 서비스 — 코드는 로컬 사본(path), 운영은 ssh(remote)
  my-remote-service:
    path: /path/to/local/clone
    commands: []
    remote:
      host: my-server            # ~/.ssh/config 의 Host 별칭
      path: /Users/me/my-service
      notes: "launchd 서비스 com.example.*, 로그는 logs/ 아래"
